@page "/test-form"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Models
@inject ISnackbar Snackbar

<PageTitle>Test Form</PageTitle>

<div style="max-width: 600px; margin: 50px auto; padding: 20px; background: white; border-radius: 8px;">
    <h2>Test Form Submission (WITHOUT MudBlazor DatePicker)</h2>
    
    <EditForm Model="@model" OnValidSubmit="@HandleSubmit" FormName="testForm">
        <DataAnnotationsValidator />
        
        <div style="margin-bottom: 15px;">
            <label>Title:</label>
            <InputText @bind-Value="model.Title" class="form-control" />
        </div>
        
        <div style="margin-bottom: 15px;">
            <label>Location:</label>
            <InputText @bind-Value="model.Location" class="form-control" />
        </div>
        
        <div style="margin-bottom: 15px;">
            <label>Event Date:</label>
            <InputDate @bind-Value="model.EventDate" class="form-control" />
        </div>
        
        <div style="margin-bottom: 15px;">
            <label>Judge Count:</label>
            <InputNumber @bind-Value="model.JudgeCount" class="form-control" />
        </div>
        
        <div style="margin-bottom: 15px;">
            <label>Admin PIN:</label>
            <InputText @bind-Value="model.AdminPin" type="password" class="form-control" />
        </div>
        
        <div style="margin-bottom: 15px;">
            <label>Judge PIN:</label>
            <InputText @bind-Value="model.JudgePin" type="password" class="form-control" />
        </div>
        
        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <span>Submitting...</span>
            }
            else
            {
                <span>Submit Form</span>
            }
        </button>
    </EditForm>
    
    @if (!string.IsNullOrEmpty(result))
    {
        <div style="margin-top: 20px; padding: 15px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 4px;">
            @result
        </div>
    }
</div>

@code {
    private CreateEventViewModel model = new();
    private bool isSubmitting = false;
    private string result = string.Empty;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        result = string.Empty;
        
        try
        {
            // Simulate submission
            await Task.Delay(500);
            result = $"✅ Form submitted successfully! Title: {model.Title}, Date: {model.EventDate}, Location: {model.Location}";
            Snackbar.Add("Form submission successful!", Severity.Success);
        }
        catch (Exception ex)
        {
            result = $"❌ Error: {ex.Message}";
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
