@page "/judge/scoring"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Models
@using BreakingScoreBoard.Api.Contracts.Battles
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Judge Scoring</PageTitle>

<PageContainer Title="Judge Scoring Panel">

    @if (!isAuthenticated)
    {
        <!-- Judge PIN Authentication -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="form-panel pa-4">
                    <h2 class="section-header no-margin-top">Judge Authentication</h2>
                    
                    @if (!string.IsNullOrEmpty(authError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4">@authError</MudAlert>
                    }

                    <MudTextField @bind-Value="judgePin" 
                                  Label="Judge PIN" 
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               FullWidth="true"
                               OnClick="@Authenticate"
                               Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.VpnLock" Class="mr-2" />
                        Authenticate
                    </MudButton>

                    <MudAlert Severity="Severity.Info">
                        Enter the judge PIN provided by the event organizer to access scoring.
                    </MudAlert>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- Scoring Interface -->
        <MudGrid>
            <!-- Battle Finder -->
            <MudItem xs="12" lg="6">
                <MudPaper Class="form-panel pa-4">
                    <h2 class="section-header no-margin-top">Find Battle</h2>
                    
                    @if (!string.IsNullOrEmpty(loadError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4">@loadError</MudAlert>
                    }

                    <MudTextField @bind-Value="battleIdInput" 
                                  Label="Battle ID" 
                                  Variant="Variant.Outlined"
                                  HelperText="Enter the battle ID to load scoring interface"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               OnClick="@LoadBattle" 
                               Disabled="@isLoading"
                               Class="mb-3">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Load Battle</span>
                        }
                    </MudButton>
                </MudPaper>

                @if (currentBattle != null)
                {
                    <MudPaper Class="form-panel pa-4 mt-4">
                        <h3 class="section-header no-margin-top">Battle Details</h3>
                        
                        <div class="mb-3">
                            <strong class="text-muted-light">Battle ID:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Id.ToString()[..8]</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Breaker 1:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Breaker1Name</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Breaker 2:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Breaker2Name</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Status:</strong>
                            <div class="mt-1">
                                <MudChip Value="currentBattle.Status" 
                                         Color="@GetStatusColor(currentBattle.Status.ToString())" 
                                         Variant="Variant.Filled" 
                                         Size="Size.Small">@currentBattle.Status</MudChip>
                            </div>
                        </div>

                        <div>
                            <strong class="text-muted-light">Bracket Level:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.BracketLevel</div>
                        </div>
                    </MudPaper>
                }
            </MudItem>

            <!-- Scoring Form -->
            <MudItem xs="12" lg="6">
                @if (currentBattle != null)
                {
                    <MudPaper Class="form-panel pa-4">
                        <h2 class="section-header no-margin-top">Submit Scores</h2>
                        
                        @if (!string.IsNullOrEmpty(scoreError))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-4">@scoreError</MudAlert>
                        }
                        @if (!string.IsNullOrEmpty(scoreSuccess))
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-4">@scoreSuccess</MudAlert>
                        }

                        <EditForm Model="@scoreModel" OnValidSubmit="@SubmitScores">
                            <DataAnnotationsValidator />

                            <MudSelect @bind-Value="scoreModel.JudgeNumber" 
                                       Label="Judge Number" 
                                       Variant="Variant.Outlined"
                                       Class="mb-4">
                                <MudSelectItem Value="1">Judge 1</MudSelectItem>
                                <MudSelectItem Value="2">Judge 2</MudSelectItem>
                                <MudSelectItem Value="3">Judge 3</MudSelectItem>
                            </MudSelect>

                            <MudNumericField @bind-Value="scoreModel.Breaker1Score" 
                                             Label="@($"{currentBattle.Breaker1Name} Score (0-100)")" 
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Max="100"
                                             Class="mb-4" />
                            <ValidationMessage For="@(() => scoreModel.Breaker1Score)" />

                            <MudNumericField @bind-Value="scoreModel.Breaker2Score" 
                                             Label="@($"{currentBattle.Breaker2Name} Score (0-100)")" 
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Max="100"
                                             Class="mb-4" />
                            <ValidationMessage For="@(() => scoreModel.Breaker2Score)" />

                            <MudButton ButtonType="ButtonType.Submit" 
                                       Variant="Variant.Filled" 
                                       Color="Color.Success" 
                                       FullWidth="true"
                                       Disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <span>Submit Scores</span>
                                }
                            </MudButton>
                        </EditForm>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="form-panel empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Large" />
                        <p class="mt-3">Enter a Battle ID to start scoring</p>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</PageContainer>

@code {
    [SupplyParameterFromQuery(Name = "eventId")]
    public string? EventIdFromQuery { get; set; }
    
    [SupplyParameterFromQuery(Name = "battleId")]
    public string? BattleIdFromQuery { get; set; }
    
    private bool isAuthenticated = false;
    private string judgePin = string.Empty;
    private string? authError;

    private string battleIdInput = string.Empty;
    private BattleDetailResponse? currentBattle;
    private SubmitScoresViewModel scoreModel = new();
    
    private bool isLoading = false;
    private bool isSubmitting = false;
    private string? loadError;
    private string? scoreError;
    private string? scoreSuccess;
    
    protected override void OnInitialized()
    {
        // If battleId provided in query string, populate the battle ID field
        // Note: We don't auto-load because authentication is required first
        if (!string.IsNullOrWhiteSpace(BattleIdFromQuery))
        {
            battleIdInput = BattleIdFromQuery;
        }
        else if (!string.IsNullOrWhiteSpace(EventIdFromQuery))
        {
            battleIdInput = EventIdFromQuery;
        }
    }

    private void Authenticate()
    {
        if (string.IsNullOrWhiteSpace(judgePin))
        {
            authError = "Please enter a Judge PIN";
            return;
        }

        // Store PIN for API calls (in real app, validate via API)
        isAuthenticated = true;
        authError = null;
    }

    private async Task LoadBattle()
    {
        if (string.IsNullOrWhiteSpace(battleIdInput) || !Guid.TryParse(battleIdInput, out var battleId))
        {
            loadError = "Please enter a valid Battle ID";
            return;
        }

        isLoading = true;
        loadError = null;
        scoreSuccess = null;
        scoreError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            
            var response = await client.GetAsync($"/battles/{battleId}");

            if (response.IsSuccessStatusCode)
            {
                currentBattle = await response.Content.ReadFromJsonAsync<BattleDetailResponse>();
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                loadError = $"Error loading battle: {response.StatusCode}";
                currentBattle = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Exception: {ex.Message}";
            currentBattle = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitScores()
    {
        if (currentBattle == null) return;

        isSubmitting = true;
        scoreError = null;
        scoreSuccess = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            client.DefaultRequestHeaders.Add("X-Pin", judgePin);

            var requestDto = new
            {
                battleId = currentBattle.Id,
                judgeIdentifier = scoreModel.JudgeNumber,
                breaker1Score = scoreModel.Breaker1Score,
                breaker2Score = scoreModel.Breaker2Score
            };

            var response = await client.PostAsJsonAsync("/scores", requestDto);

            if (response.IsSuccessStatusCode)
            {
                scoreSuccess = "Scores submitted successfully!";
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                scoreError = $"Error: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            scoreError = $"Exception: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Scheduled" => Color.Secondary,
            "InProgress" => Color.Primary,
            "RevealCountdown" => Color.Warning,
            "Completed" => Color.Success,
            "Walkover" => Color.Info,
            _ => Color.Dark
        };
    }
}
