@page "/judge/scoring"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Models
@using BreakingScoreBoard.Api.Contracts.Battles
@using BreakingScoreBoard.Api.Contracts.Events
@using BreakingScoreBoard.Api.Contracts.Public
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject EventsApiClient EventsClient
@inject PublicApiClient PublicClient
@inject ISnackbar Snackbar

<PageTitle>Judge Scoring</PageTitle>

<PageContainer Title="Judge Scoring Panel">

    @if (!isAuthenticated)
    {
        <!-- Judge PIN Authentication -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="form-panel pa-4">
                    <h2 class="section-header no-margin-top">Judge Authentication</h2>
                    
                    @if (!string.IsNullOrEmpty(authError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4">@authError</MudAlert>
                    }

                    <MudSelect T="Guid?"
                               Value="@selectedEventId"
                               ValueChanged="@OnEventSelected"
                               Label="Event"
                               Variant="Variant.Outlined"
                               HelperText="Select the event you're judging"
                               Class="mb-4"
                               Disabled="@isLoadingEvents">
                        <MudSelectItem T="Guid?" Value="null">Select an event...</MudSelectItem>
                        @if (events != null)
                        {
                            @foreach (var evt in events)
                            {
                                <MudSelectItem T="Guid?" Value="@evt.Id">@evt.Title (@evt.EventDate.ToString("dd.MM.yyyy"))</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="Guid?"
                               Value="@selectedBattleId"
                               ValueChanged="@OnBattleSelected"
                               Label="Active Battle"
                               Variant="Variant.Outlined"
                               HelperText="@GetBattleHelperText()"
                               Class="mb-4"
                               Disabled="@(selectedEventId == null || isLoadingBattles || activeBattles == null || !activeBattles.Any())">
                        <MudSelectItem T="Guid?" Value="null">Select a battle...</MudSelectItem>
                        @if (activeBattles != null)
                        {
                            @foreach (var battle in activeBattles)
                            {
                                <MudSelectItem T="Guid?" Value="@battle.BattleId">
                                    @battle.CategoryName: @battle.Breaker1.Name vs @battle.Breaker2.Name
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="judgePin" 
                                  Label="Judge PIN" 
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  HelperText="Enter your judge PIN"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               FullWidth="true"
                               OnClick="@Authenticate"
                               Disabled="@isAuthenticating"
                               Class="mb-3">
                        @if (isAuthenticating)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Validating...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.VpnLock" Class="mr-2" />
                            <span>Authenticate</span>
                        }
                    </MudButton>

                    <MudAlert Severity="Severity.Info">
                        Enter the battle ID and judge PIN provided by the event organizer.
                    </MudAlert>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- Scoring Interface -->
        <MudGrid>
            <!-- Battle Details -->
            <MudItem xs="12" lg="6">
                @if (currentBattle != null)
                {
                    <MudPaper Class="form-panel pa-4 mt-4">
                        <h3 class="section-header no-margin-top">Battle Details</h3>
                        
                        <div class="mb-3">
                            <strong class="text-muted-light">Battle ID:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Id.ToString()[..8]</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Breaker 1:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Breaker1Name</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Breaker 2:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.Breaker2Name</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted-light">Status:</strong>
                            <div class="mt-1">
                                <MudChip Value="currentBattle.Status" 
                                         Color="@GetStatusColor(currentBattle.Status.ToString())" 
                                         Variant="Variant.Filled" 
                                         Size="Size.Small">@currentBattle.Status</MudChip>
                            </div>
                        </div>

                        <div>
                            <strong class="text-muted-light">Bracket Level:</strong>
                            <div class="text-muted-light mt-1">@currentBattle.BracketLevel</div>
                        </div>
                    </MudPaper>
                }
            </MudItem>

            <!-- Scoring Form -->
            <MudItem xs="12" lg="6">
                @if (currentBattle != null)
                {
                    <MudPaper Class="form-panel pa-4">
                        <h2 class="section-header no-margin-top">Submit Scores</h2>
                        
                        @if (!string.IsNullOrEmpty(scoreError))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-4">@scoreError</MudAlert>
                        }
                        @if (!string.IsNullOrEmpty(scoreSuccess))
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-4">@scoreSuccess</MudAlert>
                        }

                        <EditForm Model="@scoreModel" OnValidSubmit="@SubmitScores">
                            <DataAnnotationsValidator />

                            <MudSelect @bind-Value="scoreModel.JudgeNumber" 
                                       Label="Judge Number" 
                                       Variant="Variant.Outlined"
                                       Class="mb-4">
                                <MudSelectItem Value="1">Judge 1</MudSelectItem>
                                <MudSelectItem Value="2">Judge 2</MudSelectItem>
                                <MudSelectItem Value="3">Judge 3</MudSelectItem>
                            </MudSelect>

                            <MudNumericField @bind-Value="scoreModel.Breaker1Score" 
                                             Label="@($"{currentBattle.Breaker1Name} Score (0-100)")" 
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Max="100"
                                             Class="mb-4" />
                            <ValidationMessage For="@(() => scoreModel.Breaker1Score)" />

                            <MudNumericField @bind-Value="scoreModel.Breaker2Score" 
                                             Label="@($"{currentBattle.Breaker2Name} Score (0-100)")" 
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Max="100"
                                             Class="mb-4" />
                            <ValidationMessage For="@(() => scoreModel.Breaker2Score)" />

                            <MudButton ButtonType="ButtonType.Submit" 
                                       Variant="Variant.Filled" 
                                       Color="Color.Success" 
                                       FullWidth="true"
                                       Disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <span>Submit Scores</span>
                                }
                            </MudButton>
                        </EditForm>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="form-panel empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Large" />
                        <p class="mt-3">Select an event and battle to start scoring</p>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</PageContainer>

@code {
    [SupplyParameterFromQuery(Name = "eventId")]
    public string? EventIdFromQuery { get; set; }
    
    [SupplyParameterFromQuery(Name = "battleId")]
    public string? BattleIdFromQuery { get; set; }
    
    private bool isAuthenticated = false;
    private bool isAuthenticating = false;
    private string judgePin = string.Empty;
    private string? authError;

    // Event and battle selection
    private List<EventResponse>? events;
    private Guid? selectedEventId;
    private List<LiveBattleResponse>? activeBattles;
    private Guid? selectedBattleId;
    private bool isLoadingEvents = false;
    private bool isLoadingBattles = false;
    
    private Guid? eventIdForPin;
    private BattleDetailResponse? currentBattle;
    private SubmitScoresViewModel scoreModel = new();
    
    private bool isSubmitting = false;
    private string? scoreError;
    private string? scoreSuccess;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadEventsAsync();
        
        // If eventId provided in query string, pre-select it
        if (!string.IsNullOrWhiteSpace(EventIdFromQuery) && Guid.TryParse(EventIdFromQuery, out var eventId))
        {
            selectedEventId = eventId;
            await OnEventSelected(eventId);
        }
        
        // If battleId provided in query string, try to select it
        if (!string.IsNullOrWhiteSpace(BattleIdFromQuery) && Guid.TryParse(BattleIdFromQuery, out var battleId))
        {
            selectedBattleId = battleId;
            await OnBattleSelected(battleId);
        }
    }
    
    private async Task LoadEventsAsync()
    {
        isLoadingEvents = true;
        try
        {
            events = await EventsClient.GetEventsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading events: {ex.Message}", Severity.Error);
            events = new List<EventResponse>();
        }
        finally
        {
            isLoadingEvents = false;
        }
    }
    
    private async Task OnEventSelected(Guid? eventId)
    {
        selectedEventId = eventId;
        selectedBattleId = null;
        currentBattle = null;
        activeBattles = null;
        scoreModel = new SubmitScoresViewModel();
        authError = null;
        scoreError = null;
        scoreSuccess = null;
        
        if (eventId == null)
        {
            return;
        }
        
        isLoadingBattles = true;
        try
        {
            var scoreboard = await PublicClient.GetScoreboardAsync(eventId.Value);
            activeBattles = scoreboard.ActiveBattles;
            
            if (activeBattles == null || !activeBattles.Any())
            {
                Snackbar.Add("No active battles found for this event", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading battles: {ex.Message}", Severity.Error);
            activeBattles = new List<LiveBattleResponse>();
        }
        finally
        {
            isLoadingBattles = false;
        }
    }
    
    private async Task OnBattleSelected(Guid? battleId)
    {
        selectedBattleId = battleId;
        currentBattle = null;
        scoreModel = new SubmitScoresViewModel();
        scoreError = null;
        scoreSuccess = null;
        
        if (battleId == null)
        {
            return;
        }
        
        // Auto-load the battle
        await LoadBattleAsync(battleId.Value);
    }
    
    private string GetBattleHelperText()
    {
        if (selectedEventId == null)
        {
            return "Select an event first";
        }
        if (isLoadingBattles)
        {
            return "Loading battles...";
        }
        if (activeBattles == null || !activeBattles.Any())
        {
            return "No active battles for this event";
        }
        return "Select a battle to score";
    }

    private async Task Authenticate()
    {
        authError = null;
        
        if (selectedEventId == null)
        {
            authError = "Please select an event";
            return;
        }
        
        if (selectedBattleId == null)
        {
            authError = "Please select a battle";
            return;
        }

        if (string.IsNullOrWhiteSpace(judgePin))
        {
            authError = "Please enter your Judge PIN";
            return;
        }

        isAuthenticating = true;
        
        try
        {
            eventIdForPin = selectedEventId.Value;
            
            // Validate the PIN using the dedicated validation endpoint
            var testClient = ClientFactory.CreateClient();
            testClient.BaseAddress = new Uri(Navigation.BaseUri);
            testClient.DefaultRequestHeaders.Add("X-Pin", judgePin);
            
            // Call the PIN validation endpoint
            var pinTestResponse = await testClient.PostAsync($"/scores/validate-pin?eventId={eventIdForPin}", null);
            
            // Check if authentication failed (401 = unauthorized/invalid PIN)
            if (pinTestResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                authError = "Invalid Judge PIN. Please check your PIN and try again.";
                eventIdForPin = null;
                return;
            }
            
            if (!pinTestResponse.IsSuccessStatusCode)
            {
                authError = $"PIN validation failed: {pinTestResponse.StatusCode}";
                eventIdForPin = null;
                return;
            }
            
            // PIN is valid!
            isAuthenticated = true;
            authError = null;
        }
        catch (Exception ex)
        {
            authError = $"Authentication failed: {ex.Message}";
            eventIdForPin = null;
        }
        finally
        {
            isAuthenticating = false;
        }
    }

    private async Task LoadBattleAsync(Guid battleId)
    {
        scoreSuccess = null;
        scoreError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            
            var response = await client.GetAsync($"/battles/{battleId}");

            if (response.IsSuccessStatusCode)
            {
                currentBattle = await response.Content.ReadFromJsonAsync<BattleDetailResponse>();
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                Snackbar.Add($"Error loading battle: {response.StatusCode}", Severity.Error);
                currentBattle = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading battle: {ex.Message}", Severity.Error);
            currentBattle = null;
        }
    }

    private async Task SubmitScores()
    {
        if (currentBattle == null) return;

        isSubmitting = true;
        scoreError = null;
        scoreSuccess = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            client.DefaultRequestHeaders.Add("X-Pin", judgePin);
            
            // Include eventId in query for PIN validation
            var url = eventIdForPin.HasValue 
                ? $"/scores?eventId={eventIdForPin.Value}" 
                : "/scores";

            var requestDto = new
            {
                battleId = currentBattle.Id,
                judgeIdentifier = scoreModel.JudgeNumber,
                breaker1Score = scoreModel.Breaker1Score,
                breaker2Score = scoreModel.Breaker2Score
            };

            var response = await client.PostAsJsonAsync(url, requestDto);

            if (response.IsSuccessStatusCode)
            {
                scoreSuccess = "Scores submitted successfully!";
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                scoreError = $"Error: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            scoreError = $"Exception: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Scheduled" => Color.Secondary,
            "InProgress" => Color.Primary,
            "RevealCountdown" => Color.Warning,
            "Completed" => Color.Success,
            "Walkover" => Color.Info,
            _ => Color.Dark
        };
    }
}
