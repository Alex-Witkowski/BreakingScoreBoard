@page "/judge/scoring"
@using BreakingScoreBoard.Api.Models
@using BreakingScoreBoard.Api.Contracts.Battles
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Judge Scoring</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-4 text-success">
        <i class="bi bi-star-fill"></i> Judge Scoring Panel
    </h1>

    @if (!isAuthenticated)
    {
        <!-- Judge PIN Authentication -->
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Judge Authentication</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(authError))
                        {
                            <div class="alert alert-danger">@authError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Enter Judge PIN</label>
                            <input type="password" @bind="judgePin" @bind:event="oninput" class="form-control" placeholder="Judge PIN" />
                        </div>

                        <button class="btn btn-success w-100" @onclick="Authenticate">
                            <i class="bi bi-shield-check"></i> Authenticate
                        </button>

                        <div class="alert alert-info mt-3 mb-0">
                            <small>
                                <i class="bi bi-info-circle"></i>
                                Enter the judge PIN provided by the event organizer to access scoring.
                            </small>
                        </div>
                    </div>              </div>
            </div>
        </div>
    }
    else
    {
        <!-- Scoring Interface -->
        <div class="row">
            <div class="col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Find Battle</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(loadError))
                        {
                            <div class="alert alert-danger">@loadError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Battle ID</label>
                            <input type="text" @bind="battleIdInput" @bind:event="oninput" class="form-control" placeholder="Enter Battle ID" />
                        </div>

                        <button class="btn btn-primary w-100" @onclick="LoadBattle" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <text> Loading...</text>
                            }
                            else
                            {
                                <text>Load Battle</text>
                            }
                        </button>
                    </div>
                </div>

                @if (currentBattle != null)
                {
                    <div class="card shadow mt-3">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Battle Details</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Battle ID:</dt>
                                <dd class="col-sm-8"><code>@currentBattle.Id.ToString()[..8]</code></dd>

                                <dt class="col-sm-4">Breaker 1:</dt>
                                <dd class="col-sm-8">@currentBattle.Breaker1Name</dd>

                                <dt class="col-sm-4">Breaker 2:</dt>
                                <dd class="col-sm-8">@currentBattle.Breaker2Name </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@GetStatusColor(currentBattle.Status.ToString())">
                                        @currentBattle.Status
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Level:</dt>
                                <dd class="col-sm-8">@currentBattle.BracketLevel</dd>
                            </dl>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                @if (currentBattle != null)
                {
                    <div class="card shadow">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Submit Scores</h5>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(scoreError))
                            {
                                <div class="alert alert-danger">@scoreError</div>
                            }
                            @if (!string.IsNullOrEmpty(scoreSuccess))
                            {
                                <div class="alert alert-success">@scoreSuccess</div>
                            }

                            <EditForm Model="@scoreModel" OnValidSubmit="@SubmitScores">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Judge Number</label>
                                    <InputSelect @bind-Value="scoreModel.JudgeNumber" class="form-select">
                                        <option value="1">Judge 1</option>
                                        <option value="2">Judge 2</option>
                                        <option value="3">Judge 3</option>
                                    </InputSelect>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">@currentBattle.Breaker1Name Score (0-100)</label>
                                    <InputNumber @bind-Value="scoreModel.Breaker1Score" class="form-control" />
                                    <ValidationMessage For="@(() => scoreModel.Breaker1Score)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">@currentBattle.Breaker2Name Score (0-100)</label>
                                    <InputNumber @bind-Value="scoreModel.Breaker2Score" class="form-control" />
                                    <ValidationMessage For="@(() => scoreModel.Breaker2Score)" />
                                </div>

                                <button type="submit" class="btn btn-success w-100" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                        <text> Submitting...</text>
                                    }
                                    else
                                    {
                                        <text>Submit Scores</text>
                                    }
                                </button>
                            </EditForm>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow">
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-search" style="font-size: 3rem;"></i>
                            <p class="mt-3">Enter a Battle ID to start scoring</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isAuthenticated = false;
    private string judgePin = string.Empty;
    private string? authError;

    private string battleIdInput = string.Empty;
    private BattleDetailResponse? currentBattle;
    private SubmitScoresViewModel scoreModel = new();
    
    private bool isLoading = false;
    private bool isSubmitting = false;
    private string? loadError;
    private string? scoreError;
    private string? scoreSuccess;

    private void Authenticate()
    {
        if (string.IsNullOrWhiteSpace(judgePin))
        {
            authError = "Please enter a Judge PIN";
            return;
        }

        // Store PIN for API calls (in real app, validate via API)
        isAuthenticated = true;
        authError = null;
    }

    private async Task LoadBattle()
    {
        if (string.IsNullOrWhiteSpace(battleIdInput) || !Guid.TryParse(battleIdInput, out var battleId))
        {
            loadError = "Please enter a valid Battle ID";
            return;
        }

        isLoading = true;
        loadError = null;
        scoreSuccess = null;
        scoreError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            
            var response = await client.GetAsync($"/battles/{battleId}");

            if (response.IsSuccessStatusCode)
            {
                currentBattle = await response.Content.ReadFromJsonAsync<BattleDetailResponse>();
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                loadError = $"Error loading battle: {response.StatusCode}";
                currentBattle = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Exception: {ex.Message}";
            currentBattle = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitScores()
    {
        if (currentBattle == null) return;

        isSubmitting = true;
        scoreError = null;
        scoreSuccess = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            client.DefaultRequestHeaders.Add("X-Pin", judgePin);

            var requestDto = new
            {
                battleId = currentBattle.Id,
                judgeIdentifier = scoreModel.JudgeNumber,
                breaker1Score = scoreModel.Breaker1Score,
                breaker2Score = scoreModel.Breaker2Score
            };

            var response = await client.PostAsJsonAsync("/scores", requestDto);

            if (response.IsSuccessStatusCode)
            {
                scoreSuccess = "Scores submitted successfully!";
                scoreModel = new SubmitScoresViewModel();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                scoreError = $"Error: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            scoreError = $"Exception: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Scheduled" => "secondary",
            "InProgress" => "primary",
            "RevealCountdown" => "warning",
            "Completed" => "success",
            "Walkover" => "info",
            _ => "dark"
        };
    }
}
