@page "/spectator/scoreboard"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Contracts.Public
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Live Scoreboard</PageTitle>

<div class="container-fluid py-4">
    <div class="scoreboard-header">
        <h1 class="mb-4 text-info">
            <i class="bi bi-tv-fill"></i> Live Scoreboard
        </h1>
        <div class="nav-links">
            <a href="/spectator/scoreboard" class="nav-link active">Live Scoreboard</a>
            <a href="/spectator/rankings" class="nav-link">Rankings</a>
            <a href="/spectator/bracket" class="nav-link">Battle Bracket</a>
        </div>
    </div>

    <!-- Event Selector -->
    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Select Event</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(loadError))
                    {
                        <div class="alert alert-danger">@loadError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Event ID</label>
                        <input type="text" @bind="eventIdInput" @bind:event="oninput" class="form-control" placeholder="Enter Event ID" />
                    </div>

                    <button class="btn btn-primary w-100" @onclick="LoadScoreboard" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <text> Loading...</text>
                        }
                        else
                        {
                            <text>Load Scoreboard</text>
                        }
                    </button>

                    @if (scoreboard != null)
                    {
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary w-100" @onclick="LoadScoreboard">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (scoreboard != null)
            {
                <!-- Event Info -->
                <div class="card shadow mb-3">
                    <div class="card-header bg-dark text-white">
                        <h4 class="mb-0">@scoreboard.EventTitle</h4>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info">Event ID: @scoreboard.EventId.ToString()[..8]</span>
                            <span class="text-muted">
                                <i class="bi bi-clock"></i> Auto-refresh every 30s
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Active Battles -->
                @if (scoreboard.ActiveBattles.Any())
                {
                    <div class="card shadow mb-3">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-broadcast"></i> Live Battles (@scoreboard.ActiveBattles.Count)
                            </h5>
                        </div>
                        <div class="card-body">
                            @foreach (var battle in scoreboard.ActiveBattles)
                            {
                                <div class="card mb-3 border-danger">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-5">
                                                <h5 class="text-primary">@battle.Breaker1.Name</h5>
                                            </div>
                                            <div class="col-md-2 text-center">
                                                <span class="badge bg-danger">VS</span>
                                            </div>
                                            <div class="col-md-5 text-end">
                                                <h5 class="text-primary">@battle.Breaker2.Name</h5>
                                            </div>
                                        </div>
                                        <hr/>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <small class="text-muted">
                                                    <i class="bi bi-tag"></i> @battle.CategoryName
                                                </small>
                                            </div>
                                            <div class="col-md-6 text-end">
                                                <span class="badge bg-@GetStatusBadge(battle.Status.ToString())">
                                                    @battle.Status
                                                </span>
                                                <span class="badge bg-secondary ms-2">
                                                    Judges: @battle.JudgesScored/@battle.JudgesTotal
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Recent Results -->
                @if (scoreboard.RecentResults.Any())
                {
                    <div class="card shadow">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-trophy"></i> Recent Results
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var result in scoreboard.RecentResults.Take(10))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">
                                                    <i class="bi bi-trophy-fill text-warning"></i>
                                                    <strong>@result.Winner.Name</strong>
                                                    @if (result.WinnerAvgScore.HasValue)
                                                    {
                                                        <span class="badge bg-success ms-2">@result.WinnerAvgScore.Value.ToString("F2")</span>
                                                    }
                                                </h6>
                                                <small class="text-muted">
                                                    defeated @result.Loser.Name
                                                    @if (result.LoserAvgScore.HasValue)
                                                    {
                                                        <span class="badge bg-secondary ms-1">@result.LoserAvgScore.Value.ToString("F2")</span>
                                                    }
                                                </small>
                                            </div>
                                            <div class="text-end">
                                                <div class="badge bg-info">@result.CategoryName</div>
                                                <br/>
                                                <small class="text-muted">
                                                    @result.CompletedAt.ToString("HH:mm")
                                                </small>
                                            </div>
                                        </div>
                                        @if (result.IsWalkover)
                                        {
                                            <span class="badge bg-warning text-dark mt-2">Walkover</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!scoreboard.ActiveBattles.Any() && !scoreboard.RecentResults.Any())
                {
                    <div class="card shadow">
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-hourglass-split" style="font-size: 3rem;"></i>
                            <p class="mt-3">No battles available yet. Check back soon!</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card shadow">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-tv" style="font-size: 3rem;"></i>
                        <p class="mt-3">Enter an Event ID to view the scoreboard</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .scoreboard-header {
        margin-bottom: 1.5rem;
    }

    .nav-links {
        display: flex;
        gap: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 1rem;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.7);
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        transition: all 0.3s;
    }

    .nav-link:hover {
        color: white;
        border-bottom-color: rgba(255, 255, 255, 0.3);
    }

    .nav-link.active {
        color: white;
        border-bottom-color: #d32f2f;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "eventId")]
    public string? EventIdFromQuery { get; set; }
    
    private string eventIdInput = string.Empty;
    private ScoreboardResponse? scoreboard;
    private bool isLoading = false;
    private string? loadError;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        // Auto-refresh every 30 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (scoreboard != null)
            {
                await InvokeAsync(async () =>
                {
                    await LoadScoreboard();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        
        // If eventId provided in query string, auto-load the scoreboard
        if (!string.IsNullOrWhiteSpace(EventIdFromQuery))
        {
            eventIdInput = EventIdFromQuery;
            await LoadScoreboard();
        }
    }

    private async Task LoadScoreboard()
    {
        if (string.IsNullOrWhiteSpace(eventIdInput) || !Guid.TryParse(eventIdInput, out var eventId))
        {
            loadError = "Please enter a valid Event ID";
            return;
        }

        isLoading = true;
        loadError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            
            var response = await client.GetAsync($"/public/events/{eventId}/scoreboard");

            if (response.IsSuccessStatusCode)
            {
                scoreboard = await response.Content.ReadFromJsonAsync<ScoreboardResponse>();
            }
            else
            {
                loadError = $"Error loading scoreboard: {response.StatusCode}";
                scoreboard = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Exception: {ex.Message}";
            scoreboard = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Scheduled" => "secondary",
            "InProgress" => "primary",
            "RevealCountdown" => "warning",
            "Completed" => "success",
            _ => "dark"
        };
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
