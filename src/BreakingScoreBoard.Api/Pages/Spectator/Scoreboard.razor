@page "/spectator/scoreboard"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Contracts.Public
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Live Scoreboard</PageTitle>

<PageContainer Title="Live Scoreboard">

    <MudGrid>
        <MudItem xs="12" lg="4">
            <MudPaper Class="form-panel pa-4">
                <div class="subsection-header">Select Event</div>
                @if (!string.IsNullOrEmpty(loadError))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@loadError</MudAlert>
                }
                <MudTextField @bind-Value="eventIdInput" Label="Event ID" Variant="Variant.Outlined" Class="mb-4" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="@LoadScoreboard" Disabled="@isLoading" Class="mb-3">
                    @if (isLoading) { <span>Loading...</span> } else { <span>Load Scoreboard</span> }
                </MudButton>
                @if (scoreboard != null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="@LoadScoreboard">Refresh</MudButton>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="8">
            @if (scoreboard != null)
            {
                <MudPaper Class="form-panel pa-4 mb-4">
                    <h2 class="section-header no-margin-top">@scoreboard.EventTitle</h2>
                    <small class="text-muted-light">Event ID: @scoreboard.EventId.ToString()[..8]</small>
                </MudPaper>

                @if (scoreboard.ActiveBattles.Any())
                {
                    <MudPaper Class="form-panel pa-4 mb-4">
                        <h3 class="section-header no-margin-top">Live Battles (@scoreboard.ActiveBattles.Count)</h3>
                        @foreach (var battle in scoreboard.ActiveBattles)
                        {
                            <div class="battle-item">
                                <div class="battle-names">
                                    <strong class="battle-name">@battle.Breaker1.Name</strong>
                                    <span>VS</span>
                                    <strong class="battle-name">@battle.Breaker2.Name</strong>
                                </div>
                                <small class="text-muted-light">@battle.CategoryName - Status: @battle.Status</small>
                            </div>
                        }
                    </MudPaper>
                }

                @if (scoreboard.RecentResults.Any())
                {
                    <MudPaper Class="form-panel pa-4">
                        <h3 class="section-header no-margin-top">Recent Results</h3>
                        @foreach (var result in scoreboard.RecentResults.Take(10))
                        {
                            <div class="result-item">
                                <strong>@result.Winner.Name</strong> defeated <strong>@result.Loser.Name</strong>
                                <small class="text-muted-light result-meta">@result.CategoryName - @result.CompletedAt.ToString("HH:mm")</small>
                                @if (result.IsWalkover) { <small class="result-walkover">Walkover</small> }
                            </div>
                        }
                    </MudPaper>
                }

                @if (!scoreboard.ActiveBattles.Any() && !scoreboard.RecentResults.Any())
                {
                    <MudPaper Class="form-panel empty-state">
                        <p>No battles available yet</p>
                    </MudPaper>
                }
            }
            else
            {
                <MudPaper Class="form-panel empty-state">
                    <p>Enter an Event ID to view the scoreboard</p>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</PageContainer>

@code {
    [SupplyParameterFromQuery(Name = "eventId")]
    public string? EventIdFromQuery { get; set; }
    
    private string eventIdInput = string.Empty;
    private ScoreboardResponse? scoreboard;
    private bool isLoading = false;
    private string? loadError;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (scoreboard != null)
            {
                await InvokeAsync(async () =>
                {
                    await LoadScoreboard();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        
        if (!string.IsNullOrWhiteSpace(EventIdFromQuery))
        {
            eventIdInput = EventIdFromQuery;
            await LoadScoreboard();
        }
    }

    private async Task LoadScoreboard()
    {
        if (string.IsNullOrWhiteSpace(eventIdInput) || !Guid.TryParse(eventIdInput, out var eventId))
        {
            loadError = "Please enter a valid Event ID";
            return;
        }

        isLoading = true;
        loadError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var response = await client.GetAsync($"/public/events/{eventId}/scoreboard");

            if (response.IsSuccessStatusCode)
            {
                scoreboard = await response.Content.ReadFromJsonAsync<ScoreboardResponse>();
            }
            else
            {
                loadError = $"Error: {response.StatusCode}";
                scoreboard = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Exception: {ex.Message}";
            scoreboard = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
