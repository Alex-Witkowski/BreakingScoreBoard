@page "/spectator/scoreboard"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Contracts.Public
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Tournament Brackets</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-4 text-center" style="color: #ffa500; font-weight: bold;">
        <i class="bi bi-diagram-3-fill"></i> Tournament Brackets
    </h1>

    <!-- Event Selector -->
    <div class="row mb-4">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 165, 0, 0.3);">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(loadError))
                    {
                        <div class="alert alert-danger">@loadError</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" style="color: #ffffff;">Event ID</label>
                            <input type="text" @bind="eventIdInput" @bind:event="oninput" class="form-control" placeholder="Enter Event ID" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-primary w-100" @onclick="LoadBrackets" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <text> Loading...</text>
                                }
                                else
                                {
                                    <text>Load Brackets</text>
                                }
                            </button>
                        </div>
                    </div>

                    @if (brackets != null)
                    {
                        <div class="mt-3 text-center">
                            <h5 style="color: #ffa500;">@brackets.EventTitle</h5>
                            <button class="btn btn-outline-warning btn-sm mt-2" @onclick="LoadBrackets">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                            <span class="text-muted ms-3">
                                <i class="bi bi-clock"></i> Auto-refresh every 30s
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Brackets Display -->
    @if (brackets != null && brackets.Categories.Any())
    {
        <!-- Category Tabs -->
        @if (brackets.Categories.Count > 1)
        {
            <ul class="nav nav-tabs category-tabs justify-content-center mb-4">
                @foreach (var category in brackets.Categories)
                {
                    var index = brackets.Categories.IndexOf(category);
                    <li class="nav-item">
                        <button class="nav-link @(selectedCategoryIndex == index ? "active" : "")" 
                                @onclick="() => selectedCategoryIndex = index">
                            @category.CategoryName
                        </button>
                    </li>
                }
            </ul>
        }

        <!-- Display Selected Category Bracket -->
        @if (selectedCategoryIndex >= 0 && selectedCategoryIndex < brackets.Categories.Count)
        {
            <TournamentBracket CategoryBracket="@brackets.Categories[selectedCategoryIndex]" 
                             EventTitle="@brackets.EventTitle" />
        }
    }
    else if (brackets != null)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-diagram-3" style="font-size: 3rem;"></i>
            <p class="mt-3">No categories available for this event yet.</p>
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-tv" style="font-size: 3rem;"></i>
            <p class="mt-3">Enter an Event ID to view the tournament brackets</p>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "eventId")]
    public string? EventIdFromQuery { get; set; }
    
    private string eventIdInput = string.Empty;
    private EventBracketsResponse? brackets;
    private bool isLoading = false;
    private string? loadError;
    private System.Threading.Timer? refreshTimer;
    private int selectedCategoryIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        // Auto-refresh every 30 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (brackets != null)
            {
                await InvokeAsync(async () =>
                {
                    await LoadBrackets();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        
        // If eventId provided in query string, auto-load the brackets
        if (!string.IsNullOrWhiteSpace(EventIdFromQuery))
        {
            eventIdInput = EventIdFromQuery;
            await LoadBrackets();
        }
    }

    private async Task LoadBrackets()
    {
        if (string.IsNullOrWhiteSpace(eventIdInput) || !Guid.TryParse(eventIdInput, out var eventId))
        {
            loadError = "Please enter a valid Event ID";
            return;
        }

        isLoading = true;
        loadError = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            
            var response = await client.GetAsync($"/public/events/{eventId}/brackets");

            if (response.IsSuccessStatusCode)
            {
                brackets = await response.Content.ReadFromJsonAsync<EventBracketsResponse>();
                selectedCategoryIndex = 0; // Reset to first category
            }
            else
            {
                loadError = $"Error loading brackets: {response.StatusCode}";
                brackets = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Exception: {ex.Message}";
            brackets = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
