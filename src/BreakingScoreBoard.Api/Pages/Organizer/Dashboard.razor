@page "/organizer/dashboard"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Models
@using BreakingScoreBoard.Api.Services
@using BreakingScoreBoard.Api.Contracts.Events
@inject EventsApiClient EventsApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Organizer Dashboard</PageTitle>

<div class="dashboard-container">
    <!-- Navigation Tabs -->
    <div class="nav-tabs">
        <button class="nav-tab active">Create Breakdance Battle</button>
        <button class="nav-tab" @onclick='() => Navigation.NavigateTo("/judge/scoring")'>Judge Scoring</button>
        <button class="nav-tab" @onclick='() => Navigation.NavigateTo("/spectator/scoreboard")'>Spectator Scoreboard</button>
    </div>

    <!-- Create Event Form -->
    <MudPaper Class="form-panel pa-6">
        <EditForm Model="@model" OnValidSubmit="@CreateEvent" FormName="createEventForm">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="model.Title" 
                          Label="Event Titel" 
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-4"
                          Style="font-size: 1.1rem;" />
            
            <MudTextField @bind-Value="model.Location" 
                          Label="Location" 
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Style="font-size: 1.1rem;" />
            
            <div class="mb-4">
                <MudTextField @bind-Value="model.EventDateString" 
                              Label="Datum (YYYY-MM-DD)" 
                              Variant="Variant.Outlined"
                              Placeholder="2026-02-15"
                              Required="true"
                              Style="font-size: 1.1rem;" />
            </div>
            
            <MudSelect @bind-Value="model.JudgeCount" 
                       Label="Number of Judges: 3 oder 5" 
                       Variant="Variant.Outlined"
                       Class="mb-4"
                       Style="font-size: 1.1rem;">
                <MudSelectItem Value="3">3 Judges</MudSelectItem>
                <MudSelectItem Value="5">5 Judges</MudSelectItem>
            </MudSelect>
            
            <MudTextField @bind-Value="model.JudgePin" 
                          Label="Judge PIN" 
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          Class="mb-4"
                          Style="font-size: 1.1rem;" />
            
            <MudTextField @bind-Value="model.AdminPin" 
                          Label="Admin PIN" 
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          Class="mb-5"
                          Style="font-size: 1.1rem;" />
            
            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Class="submit-button"
                       Disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Creating...</span>
                }
                else
                {
                    <span>Event Erstellen</span>
                }
            </MudButton>
        </EditForm>
    </MudPaper>

    <!-- Existing Events List -->
    @if (events.Any())
    {
        <div class="event-list">
            <div class="event-list-header">
                Existing Events
            </div>
            @foreach (var evt in events.Take(5))
            {
                <div class="event-item" @onclick='() => Navigation.NavigateTo($"/events/{evt.Id}")'>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="mr-2" />
                    @evt.Title - @evt.Location - @evt.EventDate.ToString("dd.MM.yyyy")
                </div>
            }
        </div>
    }
</div>

@code {
    private CreateEventViewModel model = new();
    private bool isSubmitting = false;
    private List<EventResponse> events = new();
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
        
        // Auto-refresh disabled temporarily for testing
        // refreshTimer = new System.Threading.Timer(async _ =>
        // {
        //     await InvokeAsync(async () =>
        //     {
        //         await LoadEvents();
        //         StateHasChanged();
        //     });
        // }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadEvents()
    {
        try
        {
            var eventsList = await EventsApi.GetEventsAsync();
            events = eventsList.OrderByDescending(e => e.EventDate).ToList();
        }
        catch (Exception ex)
        {
            // Silent fail on background refresh, but log for debugging
            Console.WriteLine($"Background refresh failed: {ex.Message}");
        }
    }

    private async Task CreateEvent()
    {
        isSubmitting = true;

        try
        {
            var request = new CreateEventRequest
            {
                Title = model.Title,
                EventDate = model.EventDate,
                Location = model.Location,
                JudgeCount = model.JudgeCount,
                AdminPin = model.AdminPin,
                JudgePin = model.JudgePin
            };

            var createdEvent = await EventsApi.CreateEventAsync(request);
            Snackbar.Add($"Event '{createdEvent.Title}' created successfully!", Severity.Success);
            model = new CreateEventViewModel(); // Reset form
            await LoadEvents(); // Refresh list
            StateHasChanged(); // Force UI update
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
