@page "/organizer/dashboard"
@rendermode InteractiveServer
@using BreakingScoreBoard.Api.Models
@using BreakingScoreBoard.Api.Contracts.Events
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Organizer Dashboard</PageTitle>

@if (showSuccessToast)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success!</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="DismissToast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @successMessage
            </div>
        </div>
    </div>
}

<div class="container-fluid py-4">
    <h1 class="mb-4 text-primary">
        <i class="bi bi-kanban"></i> Organizer Dashboard
    </h1>

    <div class="row">
        <div class="col-lg-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Create New Event</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)" aria-label="Close"></button>
                        </div>
                    }

                    <EditForm Model="@model" OnValidSubmit="@CreateEvent" FormName="createEventForm">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label class="form-label">Event Title</label>
                            <InputText @bind-Value="model.Title" class="form-control" />
                            <ValidationMessage For="@(() => model.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Location</label>
                            <InputText @bind-Value="model.Location" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Event Date</label>
                            <InputDate @bind-Value="model.EventDate" class="form-control" />
                            <ValidationMessage For="@(() => model.EventDate)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Number of Judges</label>
                            <InputSelect @bind-Value="model.JudgeCount" class="form-select">
                                <option value="3">3 Judges</option>
                                <option value="5">5 Judges</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Admin PIN</label>
                            <InputText @bind-Value="model.AdminPin" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.AdminPin)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Judge PIN</label>
                            <InputText @bind-Value="model.JudgePin" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.JudgePin)" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <text> Creating...</text>
                            }
                            else
                            {
                                <text>Create Event</text>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/swagger" target="_blank" class="btn btn-outline-primary">
                            <i class="bi bi-code-square"></i> API Documentation
                        </a>
                        <a href="/judge/scoring" class="btn btn-outline-success">
                            <i class="bi bi-star"></i> Judge Scoring Page
                        </a>
                        <a href="/spectator/scoreboard" class="btn btn-outline-info">
                            <i class="bi bi-tv"></i> Spectator Scoreboard
                        </a>
                    </div>
                </div>
            </div>

            @if (lastCreatedEvent != null)
            {
                <div class="card shadow mt-3">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Last Created Event</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Event ID:</dt>
                            <dd class="col-sm-9"><code>@lastCreatedEvent.Id</code></dd>
                            
                            <dt class="col-sm-3">Title:</dt>
                            <dd class="col-sm-9">@lastCreatedEvent.Title</dd>
                            
                            <dt class="col-sm-3">Date:</dt>
                            <dd class="col-sm-9">@lastCreatedEvent.EventDate.ToString("MMMM dd, yyyy")</dd>
                            
                            <dt class="col-sm-3">Location:</dt>
                            <dd class="col-sm-9">@(lastCreatedEvent.Location ?? "Not specified")</dd>
                            
                            <dt class="col-sm-3">Registration:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@(lastCreatedEvent.RegistrationOpen ? "success" : "secondary")">
                                    @(lastCreatedEvent.RegistrationOpen ? "Open" : "Closed")
                                </span>
                            </dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">All Events</h5>
                    @if (isLoadingEvents)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                </div>
                <div class="card-body">
                    @if (events.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Event ID</th>
                                        <th>Title</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Registration</th>
                                        <th>Judges</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evt in events)
                                    {
                                        <tr>
                                            <td><code>@evt.Id</code></td>
                                            <td><strong>@evt.Title</strong></td>
                                            <td>@evt.EventDate.ToString("MMM dd, yyyy")</td>
                                            <td>@(evt.Location ?? "—")</td>
                                            <td>
                                                <span class="badge bg-@(evt.RegistrationOpen ? "success" : "secondary")">
                                                    @(evt.RegistrationOpen ? "Open" : "Closed")
                                                </span>
                                            </td>
                                            <td>@evt.JudgeCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPages > 1)
                        {
                            <nav aria-label="Events pagination">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="@(() => ChangePage(currentPage - 1))" disabled="@(currentPage == 1)">
                                            Previous
                                        </button>
                                    </li>
                                    
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        var pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <button class="page-link" @onclick="@(() => ChangePage(pageNum))">
                                                @pageNum
                                            </button>
                                        </li>
                                    }
                                    
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="@(() => ChangePage(currentPage + 1))" disabled="@(currentPage == totalPages)">
                                            Next
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                            <p class="text-center text-muted mt-2 mb-0">
                                Page @currentPage of @totalPages (Total: @totalEvents events)
                            </p>
                        }
                        else if (totalEvents > 0)
                        {
                            <p class="text-center text-muted mb-0">
                                Showing @totalEvents event@(totalEvents != 1 ? "s" : "")
                            </p>
                        }
                    }
                    else if (isLoadingEvents)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-2">No events found. Create your first event above!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateEventViewModel model = new();
    private EventResponse? lastCreatedEvent;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private bool showSuccessToast = false;
    private System.Threading.Timer? toastTimer;
    
    private List<EventResponse> events = new();
    private bool isLoadingEvents = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalEvents = 0;
    private int totalPages => (int)Math.Ceiling((double)totalEvents / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private void DismissToast()
    {
        showSuccessToast = false;
        toastTimer?.Dispose();
        StateHasChanged();
    }

    private void ShowSuccessToast(string message)
    {
        successMessage = message;
        showSuccessToast = true;
        StateHasChanged();

        // Auto-dismiss after 5 seconds
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                showSuccessToast = false;
                StateHasChanged();
            });
        }, null, 5000, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        toastTimer?.Dispose();
    }

    private async Task LoadEvents()
    {
        isLoadingEvents = true;
        StateHasChanged();
        
        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);

            var response = await client.GetAsync("/events");
            if (response.IsSuccessStatusCode)
            {
                var allEvents = await response.Content.ReadFromJsonAsync<List<EventResponse>>();
                if (allEvents != null)
                {
                    totalEvents = allEvents.Count;
                    events = allEvents
                        .OrderByDescending(e => e.EventDate)
                        .Skip((currentPage - 1) * pageSize)
                        .Take(pageSize)
                        .ToList();
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load events: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load events: {ex.Message}";
        }
        finally
        {
            isLoadingEvents = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            currentPage = newPage;
            await LoadEvents();
        }
    }

    private async Task CreateEvent()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = ClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);

            var requestDto = new
            {
                title = model.Title,
                eventDate = model.EventDate.ToString("yyyy-MM-dd"),
                location = model.Location,
                judgeCount = model.JudgeCount,
                adminPin = model.AdminPin,
                judgePin = model.JudgePin
            };

            var response = await client.PostAsJsonAsync("/events", requestDto);

            if (response.IsSuccessStatusCode)
            {
                lastCreatedEvent = await response.Content.ReadFromJsonAsync<EventResponse>();
                ShowSuccessToast($"🎉 Event '{lastCreatedEvent!.Title}' created successfully!");
                model = new CreateEventViewModel(); // Reset form
                errorMessage = null; // Clear any previous errors
                await LoadEvents(); // Refresh the events list
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
