@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-3">🎤 Breaking ScoreBoard</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Inherit" Href="/swagger" Target="_blank" Size="Size.Small" />
    </MudAppBar>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 mb-8" Style="padding: 0;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
