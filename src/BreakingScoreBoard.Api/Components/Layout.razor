@inherits LayoutComponentBase

<CascadeValue Value="@_darkTheme">
    <MudThemeProvider Theme="@_darkTheme" IsDarkMode="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    
    <MudLayout>
        <MudAppBar Elevation="0" Dense="true">
            <MudText Typo="Typo.h6" Class="ml-3">🎤 Breaking ScoreBoard</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Inherit" Href="/swagger" Target="_blank" Size="Size.Small" />
        </MudAppBar>
        
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 mb-8" Style="padding: 0;">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</CascadeValue>

@code {
    private MudTheme _darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#d32f2f",
            Secondary = "#424242",
            AppbarBackground = "#1a1a1a",
            Background = "#0a0a0a",
            Surface = "#1e1e23",
            DrawerBackground = "#141419",
            TextPrimary = "#ffffff",
            TextSecondary = "#b0b0b0"
        }
    };
}
