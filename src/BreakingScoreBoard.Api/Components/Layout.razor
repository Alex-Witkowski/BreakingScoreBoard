@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Breaking ScoreBoard</title>
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }
        
        .navbar {
            background-color: #212529;
            border-bottom: 3px solid #fd7e14;
        }
        
        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #fd7e14 !important;
        }
        
        .main-container {
            min-height: 100vh;
            padding: 2rem 0;
        }
        
        .card {
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 1.5rem;
        }
        
        .btn-primary {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }
        
        .btn-primary:hover {
            background-color: #e0681a;
            border-color: #e0681a;
        }
        
        .battle-card {
            border-left: 4px solid #fd7e14;
            padding: 1.5rem;
            margin: 1rem 0;
        }
        
        .breaker-name {
            font-weight: bold;
            font-size: 1.25rem;
        }
        
        .score-large {
            font-size: 2rem;
            font-weight: bold;
            color: #fd7e14;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">🎤 Breaking ScoreBoard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/organizer/dashboard">Organizer</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/judge/scoring">Judge</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/spectator/scoreboard">Spectator</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/swagger">API Docs</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-container">
        <div class="container">
            @Body
        </div>
    </main>

    <footer class="text-center py-4 mt-5 border-top">
        <p class="text-muted">&copy; 2026 Breaking Battle Management System</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
