@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using BreakingScoreBoard.Api

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
    <HeadOutlet />
</head>
<body>
    <MudThemeProvider Theme="@_darkTheme" IsDarkMode="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout)" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <MudContainer Class="mt-8">
                <MudText Typo="Typo.h3" Color="Color.Error">Page not found</MudText>
                <MudText Typo="Typo.body1" Class="mt-4">Sorry, there's nothing at this address.</MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
                    Go to Home
                </MudButton>
            </MudContainer>
        </NotFound>
    </Router>

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>

@code {
    private MudTheme _darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#d32f2f",
            Secondary = "#424242",
            AppbarBackground = "#1a1a1a",
            Background = "#0a0a0a",
            Surface = "#1e1e23",
            DrawerBackground = "#141419",
            TextPrimary = "#ffffff",
            TextSecondary = "#b0b0b0"
        }
    };
}
