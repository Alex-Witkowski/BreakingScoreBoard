# BreakingScoreBoard Environment Configuration
# Copy this file to .env and customize the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=breakingscoreboard
DB_PORT=5432

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# Port on which the application will be accessible
APP_PORT=8080

# Admin PIN for administrative operations (CHANGE THIS!)
ADMIN_PIN=1234

# API Base URL (used for internal HTTP client services)
# For Docker: http://localhost:8080
# For external access: https://your-domain.com
API_BASE_URL=http://localhost:8080

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL=Information

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. ALWAYS change POSTGRES_PASSWORD in production
# 2. ALWAYS change ADMIN_PIN to a secure value
# 3. Use strong passwords (minimum 12 characters, mix of upper/lower/numbers/symbols)
# 4. Never commit .env file to version control
# 5. Consider using environment variables or secrets management in production
